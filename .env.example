# Edge Agent Platform - installer configuration
#
# install.sh copies this file to .env (mode 600) on first run and fills in
# generated secrets / prompted values. Do not commit the real .env file.

# ---------------------------------------------------------------------------
# Image versions (EDG-16 AC3: .env controls which version of each image is
# deployed via UI_IMAGE_TAG / API_IMAGE_TAG). Image repository names
# (snn-edge-ui, snn-edge-api, snn-edge-db) are fixed in docker-compose.yml
# and confirmed as final.
# ---------------------------------------------------------------------------

UI_IMAGE_TAG=1.0.0
API_IMAGE_TAG=1.0.0
DB_IMAGE_TAG=1.0.0

# ---------------------------------------------------------------------------
# Network - prompted for interactively by install.sh on first run and
# written here (EDG-15 AC11). Changing these after install requires
# regenerating the TLS certificate (remove certs/edge.crt and
# certs/edge.key first, or run lib/generate-certs.sh --force).
# ---------------------------------------------------------------------------

STATIC_IP=
BIND_PORT=443

# ---------------------------------------------------------------------------
# Database - leave blank. install.sh generates secure random values on
# first run (EDG-15 AC11) and never touches them again once set (AC12).
# This is the internal MySQL connection password only - it is distinct
# from hospital/cloud-facility credentials, which are entered later via
# the Cloud Configuration screen and are never stored in this file
# (EDG-16 AC6).
# ---------------------------------------------------------------------------

EDGE_DB_NAME=edge_agent
EDGE_DB_USER=edge_app
EDGE_DB_PASSWORD=
EDGE_DB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Logging (EDG-16 AC10) - shared /var/log/edge-snn volume retention.
# Enforcement (e.g. logrotate) is not yet automated by install.sh; see
# config/logrotate-edge-snn.example and README.md.
# ---------------------------------------------------------------------------

LOG_RETENTION_DAYS=30
