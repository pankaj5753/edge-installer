# Smith+Nephew Hub - installer configuration
#
# install.sh copies this file to .env (mode 600) on first run and fills in
# generated secrets / prompted values. Do not commit the real .env file.

# ---------------------------------------------------------------------------
# Image versions: .env controls which version of each image is deployed
# via UI_IMAGE_TAG / API_IMAGE_TAG. Image repository names (snn-hub-ui,
# snn-hub-api, snn-hub-db) are fixed in docker-compose.yml and confirmed
# as final.
# ---------------------------------------------------------------------------

UI_IMAGE_TAG=v00.01.02
API_IMAGE_TAG=v00.01.03
DB_IMAGE_TAG=v00.01.00

# ---------------------------------------------------------------------------
# Network - prompted for interactively by install.sh on first run and
# written here. Changing these after install requires regenerating the TLS
# certificate (remove certs/hub.crt and certs/hub.key first, or run
# lib/generate-certs.sh --force).
# ---------------------------------------------------------------------------

STATIC_IP=
BIND_PORT=443

# ---------------------------------------------------------------------------
# Database - name/user only. The app-user and root passwords are no longer
# stored here - install.sh generates them as Docker secret files under
# ./secrets/ (db_password, db_root_password), mode 400, owned by the
# container's UID:GID, so they never appear in .env/.env.prod or in any
# support bundle built from this directory. This is the internal MySQL
# connection password only - distinct from hospital/cloud-facility
# credentials, which are entered later via the Cloud Configuration screen.
# ---------------------------------------------------------------------------

HUB_DB_NAME=hub_agent
HUB_DB_USER=hub_app

# ---------------------------------------------------------------------------
# Logging - shared hub-logs volume retention. Enforcement
# (e.g. logrotate) is not yet automated by install.sh; see
# config/logrotate-snn-hub.example and README.md.
# ---------------------------------------------------------------------------

LOG_RETENTION_DAYS=30
