# hub-api release version - install.sh copies this file to .env.prod on
# first run and overwrites APP_RELEASE_TAG from VERSION on every run
# (same always-refresh treatment as UI_IMAGE_TAG/API_IMAGE_TAG/DB_IMAGE_TAG
# in .env.example). Do not edit APP_RELEASE_TAG by hand.

APP_RELEASE_TAG=
SPRING_PROFILES_ACTIVE=prod

# ---------------------------------------------------------------------------
# JWT/Authentication Configuration
# For offline installations, these typically come from hospital's identity
# provider (Okta, Azure AD, etc.). Contact your Smith+Nephew representative
# for the correct values for your deployment.
# ---------------------------------------------------------------------------

JWT_JWKS_URI=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_CdZ1Upbgr/.well-known/jwks.json
JWT_ISSUER_URI=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_CdZ1Upbgr
AUTH_SESSION_TTL_MINUTES=5

# ---------------------------------------------------------------------------
# Okta Configuration (if using Okta for authentication)
# ---------------------------------------------------------------------------

OKTA_DOMAIN=
OKTA_AUTHORIZATION_SERVER_ID=default
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_REDIRECT_URI=
OKTA_SCOPES="openid profile email offline_access"
OKTA_MFA_MAX_ATTEMPTS=5
OKTA_REQUEST_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Proxy & Cloud Service URLs
# For offline installations, these may not be reachable. Leave empty if not
# applicable to your deployment.
# ---------------------------------------------------------------------------

BRIDGE_BASE_URL=
MIC_BASE_URL=
SNN_CLP_BASE_URL=
PROXY_BRIDGE_TIMEOUT_SECONDS=30
PROXY_MIC_TIMEOUT_SECONDS=30
SNN_CLOUD_BASE_URL=https://api-edge.qa3.bridge.sportsmed.smith-nephew.com
SNN_CLOUD_S3_REGION=us-east-2

# ---------------------------------------------------------------------------
# API Keys for Health Monitoring
# Required by the Outbound HTTPS health check (sent as the x-api-key header
# to each app's base URL). Leave empty only if this deployment has no route
# to Smith+Nephew cloud domains at all.
# ---------------------------------------------------------------------------

CLP_API_KEY=7BkdMXZmvW9qxIKa0rNIY1yxPEmyAag064mRHmtC
MIC_API_KEY=2WGAERjOlb89ajnAUa8MY5T6bD8cRmUf53C9tpCJ
APP_GATEWAY_API_KEY=W2bXKVk7MaCeMU4UF5el5Du2F86vwAP5r3PaJkOe
HEALTH_GATEWAY_API_KEY_HEADER=x-api-key
HEALTH_GATEWAY_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Unauthenticated App Base URLs
# Used by the Setup Wizard's Outbound HTTPS health check (see
# ENV_HEALTH_OUTBOUND_APPS below). Leave empty only if this deployment has
# no route to Smith+Nephew cloud domains at all.
# ---------------------------------------------------------------------------

MIC_UNAUTH_BASE_URL=https://api2.qa3.mic.sportsmed.smith-nephew.com
BRIDGE_UNAUTH_BASE_URL=https://api2.qa3.bridge.sportsmed.smith-nephew.com
CLP_AUTH_EXCHANGE_TIMEOUT_SECONDS=30
CLP_CLIENT_IDENTIFIER=native_app

# ---------------------------------------------------------------------------
# S3 Presigned Download Configuration
# For offline installations, leave empty.
# ---------------------------------------------------------------------------

PROXY_DOWNLOADS_ALLOWED_BUCKETS=
PROXY_DOWNLOADS_ALLOWED_DOMAINS=
PROXY_DOWNLOADS_ALLOWED_EXTENSIONS=.jpg,.jpeg,.tiff,.tif,.png,.svg,.bmp,.mp4,.mov,.mpeg,.avi,.txt,.json,.dcm,.mp3,.wav,.zip,.pdf,.html,.log
PROXY_DOWNLOADS_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Application Paths & Logging
# ---------------------------------------------------------------------------

APP_SWAGGER_ENABLED=true
EDGE_BIND_ADDR=0.0.0.0
ENV_TLS_CERTS_MOUNT=/etc/hub-api
ENV_TLS_CERT_FILE=keystore.p12

# Env-health outbound reachability. Each app is probed through its own base URL (see *_UNAUTH_BASE_URL/SNN_CLOUD_BASE_URL above) and must report UP.
ENV_HEALTH_OUTBOUND_APPS=clp,snn-clp,mic
ENV_HEALTH_SPEED_TEST_URL=
ENV_HEALTH_SPEED_THRESHOLD_MBPS=100
ENV_HEALTH_SPEED_TEST_TIMEOUT_SECONDS=30

APP_BASE_PATH=/opt/hub-app
APP_UPLOADS_PATH=${APP_BASE_PATH}/uploads
SERVER_LOG_PATH=/var/log/hub-api

# ---------------------------------------------------------------------------
# File Upload Configuration
# ---------------------------------------------------------------------------

FILE_UPLOAD_SINGLE_THRESHOLD_BYTES=10485760
FILE_UPLOAD_DEFAULT_CHUNK_SIZE_BYTES=10485760
FILE_UPLOAD_DISK_SAFETY_BUFFER_BYTES=104857600
FILE_UPLOAD_IMAGE_EXTENSIONS=jpg,jpeg,tiff,tif,png,svg,bmp,zip
FILE_UPLOAD_VIDEO_EXTENSIONS=mp4,mov,mpeg,avi,zip
FILE_UPLOAD_LOG_EXTENSIONS=txt,json,zip,log
FILE_UPLOAD_DICOM_EXTENSIONS=dcm,zip
FILE_UPLOAD_AUDIO_EXTENSIONS=mp3,wav,zip
FILE_UPLOAD_DOCUMENT_EXTENSIONS=zip,pdf,html
FILE_UPLOAD_OTHER_EXTENSIONS=zip
FILE_UPLOAD_ALLOWED_FILE_TYPES=image,video,log,dicom,audio,document,other

FILE_UPLOAD_PURGE_ENABLED=true
FILE_UPLOAD_PURGE_CRON="0 0 2 * * *"
FILE_UPLOAD_PURGE_CRON_ZONE=America/New_York
FILE_UPLOAD_PURGE_RETENTION_DAYS=7
FILE_UPLOAD_PURGE_BATCH_SIZE=100
FILE_UPLOAD_PURGE_DRY_RUN=false

FILE_UPLOAD_CLOUD_TRANSFER_ENABLED=false
FILE_UPLOAD_SINGLE_CLOUD_TRANSFER_INTERVAL_SECONDS=300
FILE_UPLOAD_MULTIPART_CLOUD_TRANSFER_INTERVAL_SECONDS=900
FILE_UPLOAD_CLOUD_TRANSFER_MAX_CONCURRENT=3
FILE_UPLOAD_CLOUD_TRANSFER_MAX_RETRIES=3
FILE_UPLOAD_CLOUD_TRANSFER_DEFERRED_RETRY_ATTEMPTS=8
FILE_UPLOAD_CLOUD_TRANSFER_DEFERRED_RETRY_INTERVAL_HOURS=6
FILE_UPLOAD_CLOUD_TRANSFER_TIMEOUT_SECONDS=120
FILE_UPLOAD_CLOUD_TRANSFER_STALE_CLAIM_MINUTES=15

SERVER_LOG_UPLOAD_ENABLED=false
SERVER_LOG_UPLOAD_CRON="0 0 3 * * *"
SERVER_LOG_UPLOAD_CRON_ZONE=America/New_York
SERVER_LOG_UPLOAD_LOG_DIRECTORY=${SERVER_LOG_PATH}

# Allowed file_type values on initiate (comma-separated, lowercase)
FILE_UPLOAD_FILE_TYPE_IMAGE=image
FILE_UPLOAD_FILE_TYPE_VIDEO=video
FILE_UPLOAD_FILE_TYPE_LOG=log
FILE_UPLOAD_FILE_TYPE_DICOM=dicom
FILE_UPLOAD_FILE_TYPE_AUDIO=audio
FILE_UPLOAD_FILE_TYPE_DOCUMENT=document
FILE_UPLOAD_FILE_TYPE_OTHER=other
FILE_UPLOAD_DOCUMENT_PATH_PDFS_EXTENSIONS=pdf
FILE_UPLOAD_DOCUMENT_PATH_HTML_EXTENSIONS=html
FILE_UPLOAD_DOCUMENT_PATH_DOCUMENTS_EXTENSIONS=zip

# Upload device origins and base path routing (wire paths use {uploadid})
FILE_UPLOAD_ALLOWED_INITIATED_BY=tablet,ccu
FILE_UPLOAD_INITIATED_BY_TABLET=tablet
FILE_UPLOAD_INITIATED_BY_CCU=ccu
LOCAL_FILE_UPLOAD_BASE_PATH_PROCEDURES=/procedures/{uploadid}/
LOCAL_FILE_UPLOAD_BASE_PATH_LOGS_SERVICE=/logs/service/{uploadid}/
LOCAL_FILE_UPLOAD_BASE_PATH_LOGS_AUDIT=/logs/audit/{uploadid}/

# File upload paths
LOCAL_FILE_UPLOAD_PATH_IMAGES=/procedures/{uploadid}/public/{procedureid}/{key}/images/original/
LOCAL_FILE_UPLOAD_PATH_VIDEOS=/procedures/{uploadid}/public/{procedureid}/{key}/videos/original/
LOCAL_FILE_UPLOAD_PATH_AUDIO=/procedures/{uploadid}/public/{procedureid}/{key}/audiosAnnotations/
LOCAL_FILE_UPLOAD_PATH_PDFS=/procedures/{uploadid}/public/{procedureid}/{key}/pdfs/original/
LOCAL_FILE_UPLOAD_PATH_TEXT_ANNOTATIONS=/procedures/{uploadid}/public/{procedureid}/{key}/textAnnotations/
LOCAL_FILE_UPLOAD_PATH_DOCUMENTS=/procedures/{uploadid}/public/{procedureid}/{key}/others/original/
LOCAL_FILE_UPLOAD_PATH_DICOM=/procedures/{uploadid}/dicom/{procedureid}/others/original/
LOCAL_FILE_UPLOAD_PATH_SERVICE_LOG=/logs/service/{uploadid}/
LOCAL_FILE_UPLOAD_PATH_AUDIT_LOG=/logs/audit/{uploadid}/

LOCAL_FILE_UPLOAD_ALL_PATHS=${LOCAL_FILE_UPLOAD_PATH_IMAGES},${LOCAL_FILE_UPLOAD_PATH_VIDEOS},${LOCAL_FILE_UPLOAD_PATH_AUDIO},${LOCAL_FILE_UPLOAD_PATH_DOCUMENTS},${LOCAL_FILE_UPLOAD_PATH_PDFS},${LOCAL_FILE_UPLOAD_PATH_TEXT_ANNOTATIONS},${LOCAL_FILE_UPLOAD_PATH_SERVICE_LOG},${LOCAL_FILE_UPLOAD_PATH_AUDIT_LOG}

# ---------------------------------------------------------------------------
# S3 Buckets (for cloud sync - disabled in offline mode)
# ---------------------------------------------------------------------------

S3_BUCKET_FOR_CLOUD_MEDIA_UPLOADS=
S3_BUCKET_FOR_CLOUD_LOG_UPLOADS=

# ---------------------------------------------------------------------------
# Facility M2M OAuth Configuration
# ---------------------------------------------------------------------------

USER_CREDENTIALS_GRANT_TYPE=client_credentials
M2M_OAUTH_ACCESS_TOKEN_REQUEST_TIMEOUT_SECONDS=30
M2M_OAUTH_ACCESS_TOKEN_EXPIRY_SKEW_SECONDS=240
M2M_OAUTH_ACCESS_TOKEN_DEFAULT_EXPIRES_IN_SECONDS=900
M2M_OAUTH_ACCESS_TOKEN_LAST_ERROR_MAX_LEN=512
# EDGE_FACILITY_CREDENTIALS_ENCRYPTION_KEY is intentionally NOT set here.
# install.sh generates it as a Docker secret file (./secrets/encryption_key,
# mode 400, owned by the container's UID:GID) instead - keeping it out of
# .env.prod means it never ends up in a copied/emailed support bundle.
# See application.yml's spring.provision.encryption-key binding.
FACILITY_PROVISION_CLOUD_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Cloverleaf Integration (if applicable)
# Leave SMART_LINK_BASE_URL unset (do not set it to an empty string) so
# application.yml's default (http://cis2025:9100) applies - SmartLinkProperties
# requires a non-blank baseUrl and Spring only falls back to the YAML default
# when the variable is entirely absent, not when it's present-but-empty.
# ---------------------------------------------------------------------------

#SMART_LINK_BASE_URL=
