# Example logrotate policy for the shared /var/log/edge-snn volume
# (EDG-16 AC10). Not installed automatically by install.sh - EDG-15's
# install sequence doesn't include a logrotate step, so this is provided
# for hospital IT to install manually if persistent log retention is
# required beyond Docker's own log driver.
#
# Replace <LOG_RETENTION_DAYS> with the value from .env, then install as
# /etc/logrotate.d/edge-snn on the host (requires root).

/var/lib/docker/volumes/edge-logs/_data/*.log {
    daily
    rotate <LOG_RETENTION_DAYS>
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
